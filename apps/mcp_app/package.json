{
  "name": "@workspace/mcp_app",
  "version": "1.0.0",
  "description": "A React and TypeScript MCP App template",
  "private": true,
  "main": "dist-server/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k \"vite build --watch\" \"tsx watch main.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "serve": "node dist-server/main.js",
    "start": "tsx main.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@workspace/ui": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
